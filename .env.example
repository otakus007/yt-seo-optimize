DATABASE_URL=file:../data/app.db
YOUTUBE_API_KEY=            # Data API v3 key (public data, competitors)
GOOGLE_CLIENT_ID=           # OAuth web client for own channels
GOOGLE_CLIENT_SECRET=
TOKEN_KEY=                  # 32 bytes hex; `openssl rand -hex 32`; encrypts refresh tokens
PUBLIC_ORIGIN=              # https://yt.example.com (Cloudflare Tunnel hostname); empty = localhost only
CF_ACCESS_TEAM=             # <team>.cloudflareaccess.com
CF_ACCESS_AUD=              # Access application AUD tag
