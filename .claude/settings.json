{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)", "Bash(pnpm typecheck*)", "Bash(pnpm test*)", "Bash(pnpm build*)",
      "Bash(pnpm tsx scripts/*)", "Bash(pnpm exec *)", "Bash(pnpm prisma migrate dev*)",
      "Bash(pnpm prisma generate*)", "Bash(sqlite3 data/app.db .schema*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash scripts/hooks/guard.sh" } ] }
    ]
  }
}
